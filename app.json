{
  "expo": {
    "name": "Friendship's Apple Cake Season",
    "slug": "friendships-apple-cake-season",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF3E0"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.friendships.applecake",
      "requireFullScreen": true
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "friendships-apple-cake",
    "experiments": {
      "typedRoutes": true
    }
  }
}

{
  "expo": {
    "name": "Friendship's Apple Cake Season",
    "slug": "friendships-apple-cake-season",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.friendships.applecake",
      "requireFullScreen": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "scheme": "friendships-apple-cake",
    "experiments": {
      "typedRoutes": true
    }
  }
}
